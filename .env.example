# GCP
GCP_PROJECT_ID=your-project-id
GCP_LOCATION=asia-northeast3

# Vertex AI Models
EMBEDDING_MODEL=text-multilingual-embedding-002
LLM_MODEL=gemini-2.5-flash

# Vector Search — Firestore (serverless)
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_COLLECTION_NAME=medical_event_chunks

# Legacy Vertex AI Vector Search (kept for rollback; unused after Firestore migration)
VERTEX_COLLECTION_NAME=medical_event_docs

# RAG Settings
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=7
BM25_TOP_K=10
HYBRID_ALPHA=0.6
SCORE_THRESHOLD=0.65
MAX_CONTEXT_TOKENS=4000

# Conversation
MAX_CONVERSATION_TURNS=5

# Redis (required — session memory + embedding cache)
# docker-compose sets this automatically; for bare-metal local dev use:
REDIS_URL=redis://localhost:6379/0
